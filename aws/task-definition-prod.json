{
  "family": "LeanJenkinsApp-TaskDefinition-Prod",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::794338741372:role/ecsTaskExecutionRole",  
  "containerDefinitions": [
    {
      "name": "learnjenkins",
      "image": "794338741372.dkr.ecr.us-east-1.amazonaws.com/myjenkins-app:#APP_VERSION#",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ]
    }
  ]
}